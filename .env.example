# Copy this file to `.env.local` if you need to change anything:   copy .env.example .env.local
# `.env.local` is ignored by Git. Never commit real secrets.

# Where the IdeaBloom API (ideabloom-api) is running.
# Server-side only: the browser calls /api/* on this app and Next.js forwards it here.
# Read at build time, so set it before `npm run build`.
API_URL=http://localhost:4000
